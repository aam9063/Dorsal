{
  "name": "dorsal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Turn your Strava activities.csv into your 2026 season, entirely in your browser.",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm arch && pnpm check:no-real-exports && pnpm check:brand",
    "check:no-real-exports": "node scripts/check-no-real-exports.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "fixtures": "tsx fixtures/generator/index.ts",
    "verify": "tsx scripts/verify/index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "comlink": "4.4.2",
    "gsap": "3.15.1",
    "motion": "14.14.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
